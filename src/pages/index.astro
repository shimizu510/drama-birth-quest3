---
import {
  buildAbsoluteUrl,
  formatDateLabel,
  getQuestDescription,
  getQuestSubtitle,
  normalizeQuest,
} from '../lib/quests';
import { getPlaceDescription, normalizePlace } from '../lib/places';

const site = Astro.site;
const canonical = buildAbsoluteUrl('/', site);
const questModules = import.meta.glob('../data/quests/*.json', { eager: true });
const placeModules = import.meta.glob('../data/places/*.json', { eager: true });

const quests = Object.entries(questModules)
  .map(([filePath, module]) => normalizeQuest(filePath, module))
  .sort((left, right) => {
    const leftTime = left.updatedAt ? new Date(left.updatedAt).getTime() : 0;
    const rightTime = right.updatedAt ? new Date(right.updatedAt).getTime() : 0;
    return rightTime - leftTime;
  });

const places = Object.entries(placeModules)
  .map(([filePath, module]) => normalizePlace(filePath, module))
  .sort((left, right) => {
    const leftTime = left.updatedAt ? new Date(left.updatedAt).getTime() : 0;
    const rightTime = right.updatedAt ? new Date(right.updatedAt).getTime() : 0;
    return rightTime - leftTime;
  });

const featuredPlaces = places.slice(0, 3);
const featuredQuests = quests.slice(0, 6);
const pageTitle = 'DraMap';
const pageDescription =
  'DraMap は、現実の場所を舞台にクエスト、街づくり、投稿、写真、コメントを楽しめる位置情報RPGです。DraMap の公式サイトです。';
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="google-site-verification" content="43r4xc_D4boZaBpwXqiFqyuuf29Q-2BJGERdXTmvXVk" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/app-icon.png" />
    <link rel="apple-touch-icon" href="/app-icon.png" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={buildAbsoluteUrl('/app-images/adventure-hero.png', site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <style>
      :root {
        color-scheme: light;
        --bg: #f7f8fb;
        --ink: #111827;
        --muted: #5d6675;
        --soft: #eef2f7;
        --panel: rgba(255, 255, 255, 0.92);
        --panel-strong: #ffffff;
        --line: rgba(17, 24, 39, 0.11);
        --blue: #1f65d6;
        --blue-strong: #174aa0;
        --gold: #c08a16;
        --green: #1f7a5c;
        --shadow: 0 24px 70px rgba(31, 45, 72, 0.14);
      }

      * { box-sizing: border-box; }

      html { scroll-behavior: smooth; }

      body {
        margin: 0;
        font-family: "Hiragino Sans", "Noto Sans JP", system-ui, sans-serif;
        color: var(--ink);
        background:
          radial-gradient(circle at top left, rgba(31, 101, 214, 0.12), transparent 28%),
          radial-gradient(circle at 80% 0%, rgba(192, 138, 22, 0.16), transparent 24%),
          linear-gradient(180deg, #f5f8fc 0%, var(--bg) 48%, #ffffff 100%);
      }

      a { color: inherit; }

      .shell {
        width: min(1180px, calc(100% - 32px));
        margin: 0 auto;
        padding: 20px 0 72px;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 12px 0 18px;
      }

      .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
        font-weight: 800;
      }

      .brand-mark {
        display: grid;
        width: 36px;
        height: 36px;
        place-items: center;
        border-radius: 10px;
        color: #fff;
        background: linear-gradient(135deg, var(--blue), var(--green));
      }

      .nav {
        display: flex;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: 10px;
      }

      .nav a,
      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 42px;
        padding: 10px 15px;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: rgba(255, 255, 255, 0.75);
        color: var(--ink);
        font-weight: 700;
        text-decoration: none;
      }

      .button-primary {
        border-color: transparent;
        background: var(--blue);
        color: #fff;
        box-shadow: 0 14px 30px rgba(31, 101, 214, 0.24);
      }

      .button-dark {
        border-color: transparent;
        background: #111827;
        color: #fff;
      }

      .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.02fr) minmax(320px, 0.78fr);
        gap: 28px;
        align-items: stretch;
        min-height: 620px;
        padding: 28px;
        border: 1px solid var(--line);
        border-radius: 20px;
        background:
          linear-gradient(135deg, rgba(255, 255, 255, 0.96), rgba(245, 248, 252, 0.84)),
          var(--panel);
        box-shadow: var(--shadow);
        overflow: hidden;
      }

      .hero-copy {
        display: flex;
        flex-direction: column;
        justify-content: center;
        min-width: 0;
      }

      .eyebrow {
        margin: 0 0 12px;
        color: var(--blue-strong);
        font-size: 0.84rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      h1,
      h2,
      h3,
      p {
        overflow-wrap: anywhere;
      }

      h1 {
        margin: 0;
        max-width: 720px;
        font-size: clamp(2.4rem, 6vw, 5rem);
        line-height: 1.04;
        letter-spacing: 0;
      }

      .lead {
        max-width: 760px;
        margin: 20px 0 0;
        color: var(--muted);
        font-size: 1.08rem;
        line-height: 1.9;
      }

      .hero-actions,
      .legal-links {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 24px;
      }

      .trust-row {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin-top: 30px;
      }

      .trust-item {
        min-height: 96px;
        padding: 16px;
        border: 1px solid var(--line);
        border-radius: 12px;
        background: var(--panel-strong);
      }

      .trust-item strong {
        display: block;
        font-size: 1.5rem;
      }

      .trust-item span {
        color: var(--muted);
        line-height: 1.6;
      }

      .hero-media {
        position: relative;
        min-height: 560px;
      }

      .phone-shot {
        position: absolute;
        inset: 0 0 0 auto;
        width: min(410px, 100%);
        height: 100%;
        border-radius: 24px;
        object-fit: cover;
        box-shadow: 0 28px 70px rgba(8, 20, 40, 0.26);
      }

      .mini-shot {
        position: absolute;
        left: 0;
        bottom: 36px;
        width: min(240px, 52%);
        border: 8px solid #fff;
        border-radius: 18px;
        box-shadow: 0 20px 46px rgba(8, 20, 40, 0.22);
      }

      .section {
        margin-top: 28px;
        padding: 36px 0;
      }

      .section-header {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 24px;
        margin-bottom: 18px;
      }

      h2 {
        margin: 0;
        font-size: clamp(1.8rem, 3vw, 2.7rem);
        line-height: 1.15;
      }

      .section-header p,
      .feature p,
      .content-card p,
      .support-band p {
        color: var(--muted);
        line-height: 1.8;
      }

      .feature-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
      }

      .feature {
        min-height: 220px;
        padding: 22px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--panel-strong);
        box-shadow: 0 14px 40px rgba(31, 45, 72, 0.08);
      }

      .feature-kicker {
        display: inline-flex;
        padding: 7px 10px;
        border-radius: 999px;
        background: var(--soft);
        color: var(--blue-strong);
        font-size: 0.82rem;
        font-weight: 800;
      }

      .feature h3,
      .content-card h3 {
        margin: 14px 0 8px;
        font-size: 1.2rem;
      }

      .showcase {
        display: grid;
        grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
        gap: 20px;
        align-items: center;
        padding: 24px;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: #111827;
        color: #fff;
        overflow: hidden;
      }

      .showcase p {
        color: rgba(255, 255, 255, 0.76);
        line-height: 1.9;
      }

      .showcase img {
        width: 100%;
        max-height: 660px;
        border-radius: 16px;
        object-fit: cover;
      }

      .card-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 16px;
      }

      .content-card {
        display: flex;
        min-height: 210px;
        flex-direction: column;
        justify-content: space-between;
        padding: 20px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: var(--panel-strong);
        color: inherit;
        text-decoration: none;
      }

      .quest-meta,
      .quest-date {
        margin: 0;
        color: var(--muted);
        font-size: 0.94rem;
      }

      .quest-summary {
        margin: 10px 0;
      }

      .content-link {
        color: var(--blue-strong);
        font-weight: 800;
      }

      .support-band {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 18px;
        align-items: center;
        margin-top: 28px;
        padding: 26px;
        border: 1px solid var(--line);
        border-radius: 18px;
        background: var(--panel-strong);
        box-shadow: var(--shadow);
      }

      footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 14px;
        margin-top: 36px;
        padding-top: 24px;
        border-top: 1px solid var(--line);
        color: var(--muted);
      }

      footer a {
        color: var(--ink);
        font-weight: 700;
        text-decoration: none;
      }

      @media (max-width: 900px) {
        .hero,
        .showcase,
        .support-band {
          grid-template-columns: 1fr;
        }

        .hero {
          min-height: 0;
        }

        .hero-media {
          min-height: 520px;
        }

        .feature-grid,
        .card-grid,
        .trust-row {
          grid-template-columns: 1fr;
        }

        .section-header {
          align-items: flex-start;
          flex-direction: column;
        }
      }

      @media (max-width: 640px) {
        .shell {
          width: min(100% - 20px, 1180px);
          padding-top: 10px;
        }

        .topbar {
          align-items: flex-start;
          flex-direction: column;
        }

        .nav {
          justify-content: flex-start;
        }

        .hero {
          padding: 18px;
          border-radius: 16px;
        }

        .hero-media {
          min-height: 430px;
        }

        .mini-shot {
          bottom: 18px;
          width: 56%;
        }

        .button,
        .nav a {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <header class="topbar">
        <a class="brand" href="/">
          <span class="brand-mark">D</span>
          <span>DraMap</span>
        </a>
        <nav class="nav" aria-label="主要ナビゲーション">
          <a href="#features">特徴</a>
          <a href="#places">場所</a>
          <a href="#quests">クエスト</a>
          <a href="/support/">サポート</a>
        </nav>
      </header>

      <section class="hero">
        <div class="hero-copy">
          <p class="eyebrow">Location RPG and Quest Creation</p>
          <h1>現実の街が、そのまま冒険の舞台になる。</h1>
          <p class="lead">
            DraMap は、位置情報、物語、キャラクター、街づくり、写真やコメントをひとつにつなぐ iOS 向けRPGです。
            近くの場所を探索し、出会ったモンスターと戦い、自分の物語をクエストとして投稿できます。
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#features">アプリの特徴を見る</a>
            <a class="button" href="/support/">サポートを見る</a>
            <a class="button" href="/privacy/">プライバシー</a>
          </div>
          <div class="trust-row" aria-label="サービス概要">
            <div class="trust-item">
              <strong>{quests.length}</strong>
              <span>公開クエスト</span>
            </div>
            <div class="trust-item">
              <strong>{places.length}</strong>
              <span>登録済みの場所ページ</span>
            </div>
            <div class="trust-item">
              <strong>iOS</strong>
              <span>位置情報と投稿機能に対応</span>
            </div>
          </div>
        </div>
        <div class="hero-media" aria-label="DraMap のスクリーンショット">
          <img class="phone-shot" src="/app-images/adventure-hero.png" alt="DraMap の冒険イメージ" loading="eager" />
          <img class="mini-shot" src="/app-images/map-monsters.png" alt="地図上にモンスターが出現する画面" loading="eager" />
        </div>
      </section>

      <section class="section" id="features">
        <div class="section-header">
          <div>
            <p class="eyebrow">What You Can Do</p>
            <h2>探索、創作、交流を安全に楽しむための設計。</h2>
          </div>
        </div>
        <div class="feature-grid">
          <article class="feature">
            <span class="feature-kicker">Map Quest</span>
            <h3>地図上にクエストとモンスターが出現</h3>
            <p>
              現実の場所をきっかけに、RPGのイベントやバトルが始まります。移動中の安全と現地ルールを大切にしながら、街歩きをゲーム体験に変えます。
            </p>
          </article>
          <article class="feature">
            <span class="feature-kicker">Creator</span>
            <h3>自分の物語をクエストとして投稿</h3>
            <p>
              背景、キャラクター、セリフ、演出、報酬を組み合わせて、自分だけのクエストを作成できます。公開されたクエストは個別ページとして共有できます。
            </p>
          </article>
          <article class="feature">
            <span class="feature-kicker">Places</span>
            <h3>写真やコメントを場所ページに残す</h3>
            <p>
              旅の思い出、攻略メモ、関連クエストが場所ごとにまとまります。投稿、通報、削除、プライバシーに関する案内はサポートページで確認できます。
            </p>
          </article>
        </div>
      </section>

      <section class="section">
        <div class="showcase">
          <div>
            <p class="eyebrow">Create Your Story</p>
            <h2>クエスト作成も、アプリの中心体験です。</h2>
            <p>
              DraMap では、ユーザーが物語を作り、場所に結びつけ、ほかのユーザーが体験できます。
              コメントや場所ページを通じて、遊んだ記録が次の探索につながっていきます。
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href="#quests">公開クエストを見る</a>
              <a class="button button-dark" href="/terms/">利用規約</a>
            </div>
          </div>
          <img src="/app-images/quest-creator.png" alt="クエスト作成画面のイメージ" loading="lazy" />
        </div>
      </section>

      <section class="section" id="places">
        <div class="section-header">
          <div>
            <p class="eyebrow">Place Archive</p>
            <h2>登録済みの場所ページ</h2>
            <p>場所ページには、関連クエスト、写真、コメント、公開情報がまとまります。</p>
          </div>
          <a class="button" href="/places/">場所一覧へ</a>
        </div>
        <div class="card-grid">
          {featuredPlaces.map((place) => (
            <a class="content-card" href={place.webPagePath}>
              <div>
                <h3>{place.title}</h3>
                <p class="quest-meta">{place.address}</p>
                <p class="quest-meta">クエスト {place.questCount}件 / 写真 {place.photoCount}件 / コメント {place.commentCount}件</p>
              </div>
              <p class="quest-summary">{getPlaceDescription(place)}</p>
              <span class="content-link">場所ページを見る</span>
            </a>
          ))}
        </div>
      </section>

      <section class="section" id="quests">
        <div class="section-header">
          <div>
            <p class="eyebrow">Public Quests</p>
            <h2>公開クエスト</h2>
            <p>公開クエストは個別URLを持ち、検索や共有からも確認できます。</p>
          </div>
        </div>
        <div class="card-grid">
          {featuredQuests.map((quest) => (
            <a class="content-card" href={quest.webPagePath}>
              <div>
                <h3>{quest.title}</h3>
                {getQuestSubtitle(quest) ? <p class="quest-meta">{getQuestSubtitle(quest)}</p> : null}
              </div>
              <p class="quest-summary">{getQuestDescription(quest)}</p>
              {formatDateLabel(quest.updatedAt) ? (
                <p class="quest-date">最終更新: {formatDateLabel(quest.updatedAt)}</p>
              ) : null}
              <span class="content-link">詳細ページを見る</span>
            </a>
          ))}
        </div>
      </section>

      <section class="section">
        <div class="showcase">
          <img src="/app-images/place-memories.png" alt="場所ページに写真やコメントを残す画面" loading="lazy" />
          <div>
            <p class="eyebrow">Support and Safety</p>
            <h2>位置情報、投稿、写真を扱うからこそ、案内を明確に。</h2>
            <p>
              サポートページでは、問い合わせ方法、アカウント削除、投稿削除、通報、位置情報や写真権限の確認方法をまとめています。
              App Store の審査やユーザーの初回確認にも使える公式案内です。
            </p>
            <div class="hero-actions">
              <a class="button button-primary" href="/support/">サポートページへ</a>
              <a class="button button-dark" href="/privacy/">プライバシーポリシー</a>
            </div>
          </div>
        </div>
      </section>

      <section class="support-band">
        <div>
          <p class="eyebrow">Official Pages</p>
          <h2>App Store 向けの公式URL</h2>
          <p>
            マーケティングURL、サポートURL、プライバシーポリシー、利用規約を同じドメインで確認できます。
          </p>
          <div class="legal-links">
            <a href="/support/">サポート</a>
            <a href="/privacy/">プライバシーポリシー</a>
            <a href="/terms/">利用規約</a>
          </div>
        </div>
        <a class="button button-primary" href="/support/">困ったときはこちら</a>
      </section>

      <footer>
        <span>© 2026 Yuji Shimizu. All Rights Reserved.</span>
        <span>
          <a href="/support/">Support</a> / <a href="/privacy/">Privacy</a> / <a href="/terms/">Terms</a>
        </span>
      </footer>
    </main>
  </body>
</html>
